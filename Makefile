# Hey You, Pikachu! (USA) — matching decompilation build
#
#    pikachu.yaml + symbol_addrs.txt + rom/baserom.us.z64
#        |            (uv run splat split)
#        v
#    asm/*.s  src/**/*.c skeletons  assets/*.bin  $(BUILD)/pikachu.ld
#        |             |                  |
#     (GNU as)  (asm-processor + IDO 5.3) |
#        v             v                  v
#    $(BUILD)/asm/*.o  $(BUILD)/src/*.o  $(BUILD)/assets/*.o --(ld)--> ELF
#                                                              |
#                              pikachu.z64  <--(objcopy)-------'
#                                   |
#                             sha1 gate: OK: ROM matches
#
# The C compiler is the original SGI IRIX compiler (IDO 5.3),
# statically recompiled to run natively; that is what makes a
# byte-exact match possible.

default: all

BUILD := build

BASEROM  := rom/baserom.us.z64
TARGET   := $(BUILD)/pikachu.z64
GOODSHA1 := da1a1e47a86720f9d54fb2d2d247480041bda824

# SDK-related headers are local inputs, never distributed or downloaded here.
NEED_LOCAL_SDK := $(if $(MAKECMDGOALS),$(filter-out clean distclean verify-clean check-names progress source-quality asm-fallbacks asm-fallback-summary compare-objects,$(MAKECMDGOALS)),default)
ifneq ($(strip $(NEED_LOCAL_SDK)),)
LOCAL_SDK_OK := $(shell python3 tools/materialize_ultralib.py --check >/dev/null 2>&1 && echo ok)
ifneq ($(LOCAL_SDK_OK),ok)
$(error local SDK headers are missing or differ: run python3 tools/materialize_ultralib.py --check; see docs/LOCAL_SDK.md)
endif
endif


CROSS   := mips-linux-gnu-
AS      := $(CROSS)as
LD      := $(CROSS)ld
OBJCOPY := $(CROSS)objcopy

# Game C matches IDO 5.3. SDK implementations are generated locally from the ROM.
IDO     := tools/ido-5.3/cc
HEADER_DEPS := python3 tools/header_deps.py
ASMPROC := python3 tools/asm-processor/build.py
SPLAT   := uv run splat split pikachu.yaml

ASFLAGS := -mabi=32 -march=vr4300 -mtune=vr4300 -Iinclude
I_FLAGS := -Iinclude -Iinclude/PR -Iinclude/libc -Isrc -I.
# Compiler settings for retained game C; scene-specific ISA pins follow.
OPT := -O2
MIPS := -mips2
# Scene lookups: every unit below has an exact measured MIPS1 match.
$(BUILD)/src/scenes/bedroom.o: MIPS := -mips1
$(BUILD)/src/scenes/viridian_entrance.o: MIPS := -mips1
$(BUILD)/src/scenes/viridian_forest.o: MIPS := -mips1
$(BUILD)/src/scenes/wilderness_camp.o: MIPS := -mips1
$(BUILD)/src/scenes/viridian_edge.o: MIPS := -mips1
$(BUILD)/src/scenes/playground.o: MIPS := -mips1
$(BUILD)/src/scenes/entryway.o: MIPS := -mips1
$(BUILD)/src/scenes/front_yard.o: MIPS := -mips1
$(BUILD)/src/scenes/olivine_fishing.o: MIPS := -mips1
$(BUILD)/src/scenes/olivine_lake.o: MIPS := -mips1
$(BUILD)/src/scenes/ochre_fishing.o: MIPS := -mips1
$(BUILD)/src/scenes/oddish_meadow.o: MIPS := -mips1
$(BUILD)/src/scenes/olivine_lakeshore.o: MIPS := -mips1
$(BUILD)/src/scenes/springleaf_field.o: MIPS := -mips1
$(BUILD)/src/scenes/cobalt_island.o: MIPS := -mips1
$(BUILD)/src/scenes/springleaf_entrance.o: MIPS := -mips1
$(BUILD)/src/scenes/cobalt_coast.o: MIPS := -mips1
$(BUILD)/src/scenes/cobalt_fishing.o: MIPS := -mips1
$(BUILD)/src/scenes/ochre_deep.o: MIPS := -mips1
$(BUILD)/src/scenes/abra_shop.o: MIPS := -mips1
$(BUILD)/src/scenes/ochre_entrance.o: MIPS := -mips1
# src/ovl (resident overlay): measured 5.3 -O2 over all 701 m2c drafts
# (141 exact, none needing 7.1 or -O1), so no pins.
CFLAGS   = -c -Wab,-r4300_mul -non_shared -G0 -Xcpluscomm -Xfullwarn -signed \
           $(OPT) $(MIPS) -32 -nostdinc -D_LANGUAGE_C -DTARGET_N64 -DF3DEX_GBI_2 $(I_FLAGS)

# bootstrap: the globs below are evaluated at parse time, so the split
# must be current before make reads them — on a fresh tree, after
# `make clean`, or whenever the yaml/symbols outdate the linker script
# (a new subsegment adds an asm file the stale glob would miss). asm/
# is wiped first: splat never rewrites an existing hasm file, so a
# re-cut hasm span would otherwise keep its old, overlapping contents.
NEED_SPLIT := $(shell [ -f build/pikachu.ld ] && [ build/pikachu.ld -nt pikachu.yaml ] \
                && [ build/pikachu.ld -nt symbol_addrs.txt ] || echo 1)
ifneq ($(NEED_SPLIT),)
ifneq ($(wildcard rom/baserom.us.z64),)
$(info splitting ROM...)
DUMMY := $(shell rm -rf asm && uv run splat split pikachu.yaml >&2)
endif
endif

# generated by splat; nonmatchings are inlined by asm-processor, never
# assembled standalone
AS_FILES  := $(shell find asm -name '*.s' -not -path 'asm/nonmatchings/*' 2>/dev/null)
C_FILES   := $(shell find src -name '*.c' 2>/dev/null)
BIN_FILES := $(shell find assets -name '*.bin' 2>/dev/null)

O_FILES := $(foreach f,$(AS_FILES),$(BUILD)/$(f:.s=.o)) \
           $(foreach f,$(C_FILES),$(BUILD)/$(f:.c=.o)) \
           $(foreach f,$(BIN_FILES),$(BUILD)/$(f:.bin=.o))

all: asm-fallback-summary check

clean:
	rm -rf $(BUILD)

# everything splat generates (asm, assets, skeleton .c files are kept)
distclean: clean
	rm -rf asm assets undefined_funcs_auto.txt undefined_syms_auto.txt

# ---- split ------------------------------------------------------------

$(BASEROM):
	@echo "run tools/setup.sh first (normalizes your dump into $(BASEROM))" && exit 1

split: $(BASEROM) pikachu.yaml symbol_addrs.txt
	$(SPLAT)

build/pikachu.ld: pikachu.yaml symbol_addrs.txt $(BASEROM)
	$(SPLAT)

# ---- compile / assemble ----------------------------------------------

$(BUILD)/asm/%.o: asm/%.s Makefile tools/header_deps.py
	@mkdir -p $(@D)
	$(HEADER_DEPS) --target $@ --output $(@:.o=.d) -Iinclude -I. $<
	$(AS) $(ASFLAGS) -o $@ $<

# asm-processor lets a .c file mix matched C with #pragma GLOBAL_ASM
# blocks for functions not yet decompiled, so a file is decompiled one
# function at a time while the ROM keeps matching.
$(BUILD)/src/%.o: src/%.c Makefile tools/header_deps.py
	@mkdir -p $(@D)
	$(HEADER_DEPS) --target $@ --output $(@:.o=.d) $(I_FLAGS) $<
	$(ASMPROC) $(OPT) $(IDO) -- $(AS) $(ASFLAGS) -- $(CFLAGS) -o $@ $<

# Accepted assembler-input exception: actionCommandLaunchHeldItem's C is the ROM's code, but
# as1 hoists its default-arm reload unless a block-boundary record precedes the
# default label in ugen's binary assembly. The wrapper reruns the driver's own
# stages and inserts the records declared in tools/binasm_patches/action_script_commands.json.
$(BUILD)/src/game/action_script_commands.o: src/game/action_script_commands.c tools/ido_binasm_patch.py tools/binasm_patches/action_script_commands.json Makefile tools/header_deps.py
	@mkdir -p $(@D)
	$(HEADER_DEPS) --target $@ --output $(@:.o=.d) $(I_FLAGS) $<
	$(ASMPROC) $(OPT) python3 tools/ido_binasm_patch.py tools/binasm_patches/action_script_commands.json $(IDO) -- $(AS) $(ASFLAGS) -- $(CFLAGS) -o $@ $<

$(BUILD)/assets/%.o: assets/%.bin
	@mkdir -p $(@D)
	$(LD) -r -b binary -o $@ $<

# ---- link / pack ------------------------------------------------------

# splat rewrites asm/ and undefined_* in place: it must finish before
# any object builds (a -j race here corrupted builds nondeterministically)
$(O_FILES): | $(BUILD)/pikachu.ld

$(BUILD)/pikachu.elf: $(BUILD)/pikachu.ld menu_state_aliases.ld query_state_aliases.ld rodata_aliases.ld $(O_FILES)
	$(LD) -T $(BUILD)/pikachu.ld -T undefined_funcs_auto.txt -T undefined_syms_auto.txt -T menu_state_aliases.ld -T query_state_aliases.ld -T rodata_aliases.ld \
	      -Map $(BUILD)/pikachu.map -o $@

# the ROM always builds (asm-differ iterates on non-matching states);
# only `check` (the default) enforces the byte match
$(TARGET): $(BUILD)/pikachu.elf
	$(OBJCOPY) $< -O binary $@

check: $(TARGET)
	@echo "$(GOODSHA1)  $(TARGET)" | shasum -a 1 -c - && echo "OK: ROM matches"

# ---- matching workflow ------------------------------------------------

# Freeze the current (matching!) build as the asm-differ baseline.
expected: check
	rm -rf expected
	mkdir -p expected
	cp -r build expected/build

asm-fallback-summary:
	@python3 tools/asm_fallbacks.py

asm-fallbacks:
	@python3 tools/asm_fallbacks.py --verbose

# Publication hygiene checks; these do not establish copyright clearance.
verify-clean:
	@bash tools/check_clean.sh

progress:
	uv run python tools/progress.py

# fails if a frozen name (docs/FROZEN_NAMES.json) changed since BASE (default HEAD)
check-names:
	@python3 tools/check_frozen_names.py $(if $(BASE),--base $(BASE)) $(if $(STRICT),--strict)

# ---- conveniences -----------------------------------------------------

run: $(TARGET)
	@command -v ares >/dev/null 2>&1 && exec ares $(TARGET); \
	 [ -d "/Applications/ares.app" ] && exec open -a ares $(TARGET); \
	 echo "no emulator found; install one with: brew install --cask ares"; exit 1

format:
	clang-format -i $(C_FILES)

.PHONY: verify-clean asm-fallback-summary asm-fallbacks default all check check-names clean distclean split expected progress run format

$(BUILD)/src/scenes/viridian_deep.o: MIPS := -mips1

$(BUILD)/src/scenes/credits.o: MIPS := -mips1

# Missing dependency files force a rebuild once, including existing checkouts.
# Included files only add prerequisites; the default goal remains "default".
DEP_OBJECTS := $(foreach f,$(AS_FILES),$(BUILD)/$(f:.s=.o)) $(foreach f,$(C_FILES),$(BUILD)/$(f:.c=.o))
MISSING_DEPS := $(foreach o,$(DEP_OBJECTS),$(if $(wildcard $(o:.o=.d)),,$(o)))
.PHONY: missing-dependencies
$(MISSING_DEPS): missing-dependencies
-include $(DEP_OBJECTS:.o=.d) $(wildcard $(BUILD)/src/*/*.asmproc.d)
.DELETE_ON_ERROR:

BASELINE ?= expected/build
compare-objects:
	python3 tools/compare_objects.py $(BASELINE) $(BUILD)
.PHONY: compare-objects

# BASELINE must be a previously accepted build, not the current output directory.
verify: check check-names check-interfaces verify-clean
	python3 -m pytest tests
	python3 tools/source_quality.py --check-ledger
	python3 tools/compare_objects.py $(BASELINE) $(BUILD)
	git diff --check
.PHONY: verify

# Semantic recovery inventory, independent of the matching-function census.
source-quality:
	python3 tools/source_quality.py $(if $(JSON),--json)
.PHONY: source-quality

# Reviewed ABI exceptions are fingerprinted; new or stale findings fail verification.
check-interfaces:
	python3 tools/interface_contracts.py --check
.PHONY: check-interfaces
