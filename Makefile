# Hey You, Pikachu! (USA) — matching decompilation build
#
#    config/pikachu.yaml + config/symbol_addrs.txt + rom/baserom.us.z64
#        |            (uv run splat split)
#        v
#    build/asm/*.s  src/**/*.c skeletons  build/assets/*.bin  build/pikachu.ld
#        |             |                  |
#     (GNU as)  (asm-processor + IDO 5.3) |
#        v             v                  v
#    $(BUILD)/asm/*.o  $(BUILD)/src/*.o  $(BUILD)/assets/*.o --(ld)--> ELF
#                                                              |
#                              pikachu.z64  <--(objcopy)-------'
#                                   |
#                             sha1 gate: OK: ROM matches
#
# The C compiler is the original SGI IRIX compiler (IDO 5.3),
# statically recompiled to run natively; that is what makes a
# byte-exact match possible.

default: all

BUILD := build

# Keep the shared pre-commit formatting hook installed in every worktree that
# builds. Idempotent; see tools/setup_hooks.sh.
SETUP_HOOKS := $(shell sh tools/setup_hooks.sh >&2)

BASEROM  := rom/baserom.us.z64
TARGET   := $(BUILD)/pikachu.z64
GOODSHA1 := da1a1e47a86720f9d54fb2d2d247480041bda824

# SDK-related headers are local inputs, never distributed or downloaded here.
NEED_LOCAL_SDK := $(if $(MAKECMDGOALS),$(filter-out clean distclean verify-clean check-names progress source-quality asm-fallbacks asm-fallback-summary compare-objects format-check,$(MAKECMDGOALS)),default)
ifneq ($(strip $(NEED_LOCAL_SDK)),)
LOCAL_SDK_OK := $(shell python3 tools/materialize_ultralib.py --check >/dev/null 2>&1 && echo ok)
ifneq ($(LOCAL_SDK_OK),ok)
$(error local SDK headers are missing or differ: run python3 tools/materialize_ultralib.py --check; see docs/LOCAL_SDK.md)
endif
endif


CROSS   := mips-linux-gnu-
AS      := $(CROSS)as
LD      := $(CROSS)ld
OBJCOPY := $(CROSS)objcopy

# Game C matches IDO 5.3. SDK implementations are generated locally from the ROM.
IDO     ?= tools/ido-5.3/cc
HEADER_DEPS := python3 tools/header_deps.py
ASMPROC := python3 tools/asm-processor/build.py
SPLAT   := uv run splat split config/pikachu.yaml

ASFLAGS := -mabi=32 -march=vr4300 -mtune=vr4300 -Iinclude
I_FLAGS := -Iinclude -Iinclude/PR -Iinclude/libc -Isrc -I.
# Compiler settings for retained game C; scene-specific ISA pins follow.
OPT := -O2
MIPS := -mips2
# Scene units with an exact measured MIPS1 match; everything else builds -mips2.
MIPS1_SCENES := bedroom viridian_entrance viridian_forest wilderness_camp \
                viridian_edge playground entryway front_yard \
                olivine_fishing olivine_lake ochre_fishing oddish_meadow \
                olivine_lakeshore springleaf_field cobalt_island springleaf_entrance \
                cobalt_coast cobalt_fishing ochre_deep abra_shop \
                ochre_entrance viridian_deep credits
$(foreach s,$(MIPS1_SCENES),$(BUILD)/src/scenes/$(s).o): MIPS := -mips1
# src/ovl (resident overlay): measured 5.3 -O2 over all 701 m2c drafts
# (141 exact, none needing 7.1 or -O1), so no pins.
CFLAGS   = -c -Wab,-r4300_mul -non_shared -G0 -Xcpluscomm -Xfullwarn -signed \
           $(OPT) $(MIPS) -32 -nostdinc -D_LANGUAGE_C -DTARGET_N64 -DF3DEX_GBI_2 $(I_FLAGS)

# bootstrap: the globs below are evaluated at parse time, so the split
# must be current before make reads them — on a fresh tree, after
# `make clean`, or whenever the yaml/symbols outdate the linker script
# (a new subsegment adds an asm file the stale glob would miss). build/asm/
# is wiped first: splat never rewrites an existing hasm file, so a
# re-cut hasm span would otherwise keep its old, overlapping contents.
NEED_SPLIT := $(shell [ -f build/pikachu.ld ] \
                && [ -f build/undefined_funcs_auto.txt ] && [ -f build/undefined_syms_auto.txt ] \
                && [ build/pikachu.ld -nt config/pikachu.yaml ] \
                && [ build/pikachu.ld -nt config/symbol_addrs.txt ] || echo 1)
ifneq ($(if $(MAKECMDGOALS),$(filter-out clean distclean split format-check,$(MAKECMDGOALS)),default),)
ifneq ($(NEED_SPLIT),)
ifneq ($(wildcard rom/baserom.us.z64),)
$(info splitting ROM...)
DUMMY := $(shell rm -rf build/asm && uv run splat split config/pikachu.yaml >&2 || echo FAIL)
ifeq ($(DUMMY),FAIL)
$(error ROM split failed)
endif
endif
endif
endif

# generated by splat; nonmatchings are inlined by asm-processor, never
# assembled standalone
AS_FILES  := $(shell find $(BUILD)/asm -name '*.s' -not -path '$(BUILD)/asm/nonmatchings/*' 2>/dev/null)
C_FILES   := $(shell find src -name '*.c' 2>/dev/null)
BIN_FILES := $(shell find $(BUILD)/assets -name '*.bin' 2>/dev/null)

O_FILES := $(AS_FILES:.s=.o) \
           $(foreach f,$(C_FILES),$(BUILD)/$(f:.c=.o)) \
           $(BIN_FILES:.bin=.o)

all: asm-fallback-summary check

clean:
	rm -rf $(BUILD)

# Also remove legacy generated directories from older checkouts; keep source files.
distclean: clean
	rm -rf asm assets undefined_funcs_auto.txt undefined_syms_auto.txt

# ---- split ------------------------------------------------------------

$(BASEROM):
	@echo "normalize your dump first: python3 tools/rom.py /path/to/dump.z64 $(BASEROM)" && exit 1

split: $(BASEROM) config/pikachu.yaml config/symbol_addrs.txt
	$(SPLAT)

build/pikachu.ld: config/pikachu.yaml config/symbol_addrs.txt $(BASEROM)
	$(SPLAT)

# ---- compile / assemble ----------------------------------------------

$(BUILD)/asm/%.o: $(BUILD)/asm/%.s Makefile tools/header_deps.py
	@mkdir -p $(@D)
	$(HEADER_DEPS) --target $@ --output $(@:.o=.d) -Iinclude -I. $<
	$(AS) $(ASFLAGS) -o $@ $<

# asm-processor lets a .c file mix matched C with #pragma GLOBAL_ASM
# blocks for functions not yet decompiled, so a file is decompiled one
# function at a time while the ROM keeps matching.
$(BUILD)/src/%.o: src/%.c Makefile tools/header_deps.py
	@mkdir -p $(@D)
	$(HEADER_DEPS) --target $@ --output $(@:.o=.d) $(I_FLAGS) $<
	$(ASMPROC) $(OPT) $(IDO) -- $(AS) $(ASFLAGS) -- $(CFLAGS) -o $@ $<

# Accepted assembler-input exception: actionCommandLaunchHeldItem's C is the ROM's code, but
# as1 hoists its default-arm reload unless a block-boundary record precedes the
# default label in ugen's binary assembly. The wrapper reruns the driver's own
# stages and inserts the records declared in tools/binasm_patches/action_script_commands.json.
$(BUILD)/src/game/action_script_commands.o: src/game/action_script_commands.c tools/ido_binasm_patch.py tools/binasm_patches/action_script_commands.json Makefile tools/header_deps.py
	@mkdir -p $(@D)
	$(HEADER_DEPS) --target $@ --output $(@:.o=.d) $(I_FLAGS) $<
	$(ASMPROC) $(OPT) python3 tools/ido_binasm_patch.py tools/binasm_patches/action_script_commands.json $(IDO) -- $(AS) $(ASFLAGS) -- $(CFLAGS) -o $@ $<

$(BUILD)/assets/%.o: $(BUILD)/assets/%.bin
	@mkdir -p $(@D)
	$(LD) -r -b binary -o $@ $<

# ---- link / pack ------------------------------------------------------

# splat rewrites build/asm/ and build/undefined_* in place: it must finish before
# any object builds (a -j race here corrupted builds nondeterministically)
$(O_FILES): | $(BUILD)/pikachu.ld

$(BUILD)/pikachu.elf: $(BUILD)/pikachu.ld linker/menu_state_aliases.ld linker/query_state_aliases.ld linker/rodata_aliases.ld $(O_FILES)
	$(LD) -T $(BUILD)/pikachu.ld -T $(BUILD)/undefined_funcs_auto.txt -T $(BUILD)/undefined_syms_auto.txt -T linker/menu_state_aliases.ld -T linker/query_state_aliases.ld -T linker/rodata_aliases.ld \
	      -Map $(BUILD)/pikachu.map -o $@

# The ROM always builds so asm-differ can iterate on non-matching states;
# only `check` (the default) enforces the byte match.
$(TARGET): $(BUILD)/pikachu.elf
	$(OBJCOPY) $< -O binary $@

check: $(TARGET)
	@echo "$(GOODSHA1)  $(TARGET)" | shasum -a 1 -c - && echo "OK: ROM matches"

# ---- matching workflow ------------------------------------------------

# Freeze the current (matching!) build as the asm-differ baseline.
expected: check
	rm -rf expected
	mkdir -p expected
	cp -r build expected/build

asm-fallback-summary:
	@python3 tools/asm_fallbacks.py

asm-fallbacks:
	@python3 tools/asm_fallbacks.py --verbose

# Publication hygiene checks; these do not establish copyright clearance.
verify-clean:
	@bash tools/check_clean.sh

progress:
	@uv run --locked python tools/progress.py $(if $(filter 1,$(JSON)),--json) $(if $(filter 1,$(STRICT)),--strict)

# fails if a frozen name (docs/FROZEN_NAMES.json) changed since BASE (default HEAD)
check-names:
	@python3 tools/check_frozen_names.py $(if $(BASE),--base $(BASE)) $(if $(STRICT),--strict)

# ---- conveniences -----------------------------------------------------

run: $(TARGET)
	@command -v ares >/dev/null 2>&1 && exec ares $(TARGET); \
	 [ -d "/Applications/ares.app" ] && exec open -a ares $(TARGET); \
	 echo "no emulator found; install one with: brew install --cask ares"; exit 1

format:
	clang-format -i $(C_FILES)

# Fails if a staged C file is unformatted. The pre-commit hook installed by
# setup-hooks applies the formatting instead.
format-check:
	@sh tools/format_staged.sh --check

setup-hooks:
	@sh tools/setup_hooks.sh

# Semantic recovery inventory, independent of the matching-function census.
source-quality:
	python3 tools/source_quality.py $(if $(JSON),--json)

# Optional, read-only readability analysis; IDO still builds the ROM.
tidy:
	@uv run --locked python tools/clang_tidy.py $(if $(FILES),--files $(FILES))

# Optional review tools supplement the matching/object gates.
semantic-review: check
	uv run --locked --group review python -m tools.semantic_review check $(if $(REVIEW_CORE),--core $(REVIEW_CORE))

# ---- verification -----------------------------------------------------

# Missing dependency files force a rebuild once, including existing checkouts.
# Included files only add prerequisites; the default goal remains "default".
DEP_OBJECTS  := $(AS_FILES:.s=.o) $(foreach f,$(C_FILES),$(BUILD)/$(f:.c=.o))
MISSING_DEPS := $(foreach o,$(DEP_OBJECTS),$(if $(wildcard $(o:.o=.d)),,$(o)))
$(MISSING_DEPS): missing-dependencies
-include $(DEP_OBJECTS:.o=.d) $(wildcard $(BUILD)/src/*/*.asmproc.d)

.DELETE_ON_ERROR:

# BASELINE must be a previously accepted build, not the current output directory.
BASELINE ?= expected/build

compare-objects:
	python3 tools/compare_objects.py $(BASELINE) $(BUILD)

# Reviewed ABI exceptions are fingerprinted; new or stale findings fail verification.
check-interfaces:
	python3 tools/interface_contracts.py --check

check-layouts:
	python3 tools/layout_contracts.py --check

# Check the selected retail cue bank against its registered event limit and storage.
check-sequence-bank:
	python3 tools/verify_sequence_bank.py rom/baserom.us.z64 --bank 0xB140C0 --event-limit 20 --storage 20

# These read the linked ELF, so they need the build first.
check-native-commands: $(BUILD)/pikachu.elf
	python3 tools/native_commands.py --elf $<

check-object-draw-callbacks: $(BUILD)/pikachu.elf
	python3 tools/object_draw_callbacks.py --elf $< --kind-count 0xB4

check-item-callbacks: $(BUILD)/pikachu.elf
	python3 tools/item_callbacks.py --elf $<

check-scene-callbacks: $(BUILD)/pikachu.elf
	python3 tools/scene_callbacks.py --elf $<

verify: check check-names check-scene-callbacks check-item-callbacks check-object-draw-callbacks check-native-commands check-interfaces check-layouts check-sequence-bank verify-clean
	uv run --locked python -m pytest tests
	python3 tools/source_quality.py --check-ledger
	python3 tools/compare_objects.py $(BASELINE) $(BUILD)
	git diff --check

.PHONY: default all clean distclean split check expected run format format-check setup-hooks \
        asm-fallback-summary asm-fallbacks verify-clean progress check-names \
        source-quality tidy semantic-review missing-dependencies \
        compare-objects check-interfaces check-layouts check-sequence-bank \
        check-native-commands check-object-draw-callbacks check-item-callbacks \
        check-scene-callbacks verify
